# --- Turso (libSQL / SQLite) ---
# turso db show <name> --url  /  turso db tokens create <name>
# Put real values in .env.development.local (dev) / .env.production.local (prod).
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# --- Admin auth (session signing) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=your-random-32-byte-base64-secret

# --- SEO / absolute URLs (canonical, OG, sitemap) ---
# Prod: https://www.tarumanagara.org  |  Dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.tarumanagara.org
